    </owl:NamedIndividual>
    


    <!-- https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owlUtility-Liquid_Heat_Transfer_Rule -->

    <owl:NamedIndividual rdf:about="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owlUtility-Liquid_Heat_Transfer_Rule">
        <rdf:type rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owlRule"/>
        <OntoMo:OntoMo.owlhasDescriptor rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owlHas_Liquid_Input"/>
        <OntoMo:OntoMo.owlhasDescriptor rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owlHas_Utility"/>
        <OntoMo:OntoMo.owlisAssociatedWith rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owlUtility-Liquid_Heat_Transfer"/>
        <OntoMo:OntoMo.owlhasSPARQL>select ?is_rule_match where {
    bind({Has_Utility} as ?has_utility).
    bind({Has_Liquid_Input} as ?has_liquid_input).
    bind(
        if(
            ?has_utility &amp;&amp;
            ?has_liquid_input, 
            true, 
            false) as ?is_rule_match
    ).
}</OntoMo:OntoMo.owlhasSPARQL>
    </owl:NamedIndividual>
    


