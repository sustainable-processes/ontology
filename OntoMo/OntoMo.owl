        <OntoMo:OntoMo.owlhasModelVariable rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owlUtility-Liquid_Heat_Transfer_Coefficient"/>
        <OntoMo:OntoMo.owlhasModelVariable rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owlUtility_Equilibrium_Temperature"/>
        <OntoMo:OntoMo.owlhasRule rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owlUtility-Liquid_Heat_Transfer_Rule"/>
        <OntoMo:OntoMo.owlisAssociatedWith rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owlUtility-Liquid_Heat_Transfer"/>
