        <rdf:type rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#FlowPattern"/>
        <relatesToMassTransportPhenomenon rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#Engulfment"/>
    </owl:NamedIndividual>
    


    <!-- https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#Annular_Microflow_Rule_by_Youngbae_et_al. -->

    <owl:NamedIndividual rdf:about="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#Annular_Microflow_Rule_by_Youngbae_et_al.">
        <rdf:type rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#Rule"/>
        <hasDescriptor rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#Annular_Reactor"/>
        <hasDescriptor rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#Density_Gas"/>
        <hasDescriptor rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#Flow_Rate_Gas"/>
        <hasDescriptor rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#Has_Gas_Input"/>
        <hasDescriptor rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#Has_Liquid_Input"/>
        <hasDescriptor rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#Radius"/>
        <hasDescriptor rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#Viscosity_Gas"/>
        <isAssociatedWith rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#Annular_Microflow"/>
        <hasDOI>10.1016/j.ijmultiphaseflow.2015.03.016</hasDOI>
        <hasSPARQL>select ?is_rule_match where {
    bind({Annular_Reactor} as ?annular_reactor).
    bind({Has_Gas_Input} as ?has_gas_input).
    bind({Has_Liquid_Input} as ?has_liquid_input).
    bind({Density_Gas} as ?rho_gas).
    bind({Flow_Rate_Gas} as ?q_gas).
    bind({Viscosity_Gas} as ?mu_gas).
    bind({Radius} as ?r).
    bind(
        if(
            ?annular_reactor &amp;&amp;
            ?has_gas_input &amp;&amp;
            ?has_liquid_input &amp;&amp;
            (2 * ?rho_gas * ?q_gas / 3.14 / ?r / 1000 / 60 / ?mu_gas &gt; 251), 
            true, 
            false) as ?is_rule_match
    ).
}</hasSPARQL>
    </owl:NamedIndividual>
    


    <!-- https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#Annular_Reactor -->

    <owl:NamedIndividual rdf:about="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#Annular_Reactor">
        <rdf:type rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#InformationDescriptor"/>
        <hasDefaultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</hasDefaultValue>
    </owl:NamedIndividual>
    


    <!-- https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#Annular_Reactor_Context -->

