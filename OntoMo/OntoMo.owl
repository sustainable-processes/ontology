=</mo><msqrt><mfrac><mi>ΔP</mi><msub><mi>ΔP</mi><mtext>g</mtext></msub></mfrac></msqrt></mrow><mrow><mtext>if</mtext><mspace nspace="1"></mspace><mrow><mi>Re</mi><mo>&lt;</mo><mn>2300</mn><mo>and</mo><msub><mi>Re</mi><mtext>g</mtext></msub><mo>&lt;</mo><mn>2300</mn></mrow><mtext>:</mtext></mrow><mrow><mspace nspace="4"></mspace><mrow><mi>C</mi><mo>=</mo><mn>5</mn></mrow></mrow><mrow><mtext>elif</mtext><mspace nspace="1"></mspace><mrow><mi>Re</mi><mo>≥</mo><mn>2300</mn><mo>and</mo><msub><mi>Re</mi><mtext>g</mtext></msub><mo>&lt;</mo><mn>2300</mn></mrow><mtext>:</mtext></mrow><mrow><mspace nspace="4"></mspace><mrow><mi>C</mi><mo>=</mo><mn>10</mn></mrow></mrow><mrow><mtext>elif</mtext><mspace nspace="1"></mspace><mrow><mi>Re</mi><mo>&lt;</mo><mn>2300</mn><mo>and</mo><msub><mi>Re</mi><mtext>g</mtext></msub><mo>≥</mo><mn>2300</mn></mrow><mtext>:</mtext></mrow><mrow><mspace nspace="4"></mspace><mrow><mi>C</mi><mo>=</mo><mn>12</mn></mrow></mrow><mrow><mtext>else:</mtext></mrow><mrow><mspace nspace="4"></mspace><mrow><mi>C</mi><mo>=</mo><mn>20</mn></mrow></mrow><mrow><mi>ε</mi><mo>=</mo><mrow><mo>(</mo><mn>1</mn><mo>+</mo><mfrac><mi>C</mi><mi>X</mi></mfrac><mo>+</mo><mfrac><mn>1</mn><msup><mi>X</mi><mn>2</mn></msup></mfrac><mo>)</mo></mrow><mfrac><mrow><mi>ΔP</mi><mi>u</mi></mrow><mrow><mi>ρ</mi><mi>l</mi></mrow></mfrac></mrow></math></OntoMo:OntoMo.owlhasFormula>
