    <!-- https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owlSolid-Liquid_Mass_Transfer_Rule -->

    <owl:NamedIndividual rdf:about="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owlSolid-Liquid_Mass_Transfer_Rule">
        <rdf:type rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owlRule"/>
        <OntoMo:OntoMo.owlhasDescriptor rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owlHas_Liquid_Input"/>
        <OntoMo:OntoMo.owlhasDescriptor rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owlHas_Solid_Input"/>
        <OntoMo:OntoMo.owlisAssociatedWith rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owlSolid-Liquid_Mass_Transfer"/>
        <OntoMo:OntoMo.owlhasSPARQL>select ?is_rule_match where {
    bind({Has_Solid_Input} as ?has_solid_input).
    bind({Has_Liquid_Input} as ?has_liquid_input).
    bind(
        if(
            ?has_solid_input &amp;&amp;
            ?has_liquid_input, 
            true, 
            false) as ?is_rule_match
    ).
}</OntoMo:OntoMo.owlhasSPARQL>
    </owl:NamedIndividual>
    


