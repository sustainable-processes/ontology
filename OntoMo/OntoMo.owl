        <OntoMo:OntoMo.owlrelatesToMassTransportPhenomenon rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owlEngulfment"/>
    </owl:NamedIndividual>
    


    <!-- https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owlAnnular_Microflow_Rule_by_Youngbae_et_al. -->

    <owl:NamedIndividual rdf:about="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owlAnnular_Microflow_Rule_by_Youngbae_et_al.">
        <rdf:type rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owlRule"/>
        <OntoMo:OntoMo.owlhasDescriptor rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owlAnnular_Reactor"/>
        <OntoMo:OntoMo.owlhasDescriptor rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owlDensity_Gas"/>
        <OntoMo:OntoMo.owlhasDescriptor rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owlFlow_Rate_Gas"/>
        <OntoMo:OntoMo.owlhasDescriptor rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owlHas_Gas_Input"/>
        <OntoMo:OntoMo.owlhasDescriptor rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owlHas_Liquid_Input"/>
        <OntoMo:OntoMo.owlhasDescriptor rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owlRadius"/>
        <OntoMo:OntoMo.owlhasDescriptor rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owlViscosity_Gas"/>
        <OntoMo:OntoMo.owlisAssociatedWith rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owlAnnular_Microflow"/>
        <OntoMo:OntoMo.owlhasDOI>10.1016/j.ijmultiphaseflow.2015.03.016</OntoMo:OntoMo.owlhasDOI>
        <OntoMo:OntoMo.owlhasSPARQL>select ?is_rule_match where {
    bind({Annular_Reactor} as ?annular_reactor).
    bind({Has_Gas_Input} as ?has_gas_input).
    bind({Has_Liquid_Input} as ?has_liquid_input).
    bind({Density_Gas} as ?rho_gas).
    bind({Flow_Rate_Gas} as ?q_gas).
    bind({Viscosity_Gas} as ?mu_gas).
    bind({Radius} as ?r).
    bind(
        if(
            ?annular_reactor &amp;&amp;
            ?has_gas_input &amp;&amp;
            ?has_liquid_input &amp;&amp;
            (2 * ?rho_gas * ?q_gas / 3.14 / ?r / 1000 / 60 / ?mu_gas &gt; 251), 
            true, 
            false) as ?is_rule_match
    ).
}</OntoMo:OntoMo.owlhasSPARQL>
    </owl:NamedIndividual>
    


    <!-- https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owlAnnular_Reactor -->

    <owl:NamedIndividual rdf:about="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owlAnnular_Reactor">
        <rdf:type rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owlInformationDescriptor"/>
