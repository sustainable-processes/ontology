        <hasModelVariable rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#Utility_Equilibrium_Temperature"/>
        <hasRule rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#Utility-Liquid_Heat_Transfer_Rule"/>
        <isAssociatedWith rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#Utility-Liquid_Heat_Transfer"/>
        <hasFormula rdf:parseType="Literal"><math><mrow><mi>U</mi><msub><mi>A</mi><mtext>u</mtext></msub><mrow><mo>(</mo><msup><msub><mi>T</mi><mtext>u</mtext></msub><mtext>*</mtext></msup><mo>−</mo><mi>T</mi><mo>)</mo></mrow></mrow></math></hasFormula>
    </owl:NamedIndividual>
    


    <!-- https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#Utility-Liquid_Heat_Transfer_Rule -->

    <owl:NamedIndividual rdf:about="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#Utility-Liquid_Heat_Transfer_Rule">
        <rdf:type rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#Rule"/>
        <hasDescriptor rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#Has_Liquid_Input"/>
        <hasDescriptor rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#Has_Utility"/>
        <isAssociatedWith rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#Utility-Liquid_Heat_Transfer"/>
        <hasSPARQL>select ?is_rule_match where {
    bind({Has_Utility} as ?has_utility).
    bind({Has_Liquid_Input} as ?has_liquid_input).
    bind(
        if(
            ?has_utility &amp;&amp;
            ?has_liquid_input, 
            true, 
            false) as ?is_rule_match
    ).
}</hasSPARQL>
    </owl:NamedIndividual>
    


