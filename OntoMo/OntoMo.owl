    <!-- https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owlPower_Transfer_Rule_by_Power_Number -->

    <owl:NamedIndividual rdf:about="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owlPower_Transfer_Rule_by_Power_Number">
        <rdf:type rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owlRule"/>
        <OntoMo:OntoMo.owlhasDescriptor rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owlHas_Agitator"/>
        <OntoMo:OntoMo.owlhasDescriptor rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owlHas_Liquid_Input"/>
        <OntoMo:OntoMo.owlisAssociatedWith rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owlPower_Transfer"/>
        <OntoMo:OntoMo.owlhasSPARQL>select ?is_rule_match where {
    bind({Has_Agitator} as ?has_agitator).
    bind({Has_Liquid_Input} as ?has_liquid_input).
    bind(
        if(
            ?has_agitator &amp;&amp;
            ?has_liquid_input, 
            true, 
            false) as ?is_rule_match
    ).
}</OntoMo:OntoMo.owlhasSPARQL>
    </owl:NamedIndividual>
    


