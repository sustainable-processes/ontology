    <!-- https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#Power_Transfer_Rule_by_Power_Number -->

    <owl:NamedIndividual rdf:about="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#Power_Transfer_Rule_by_Power_Number">
        <rdf:type rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#Rule"/>
        <hasDescriptor rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#Has_Agitator"/>
        <hasDescriptor rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#Has_Liquid_Input"/>
        <isAssociatedWith rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#Power_Transfer"/>
        <hasSPARQL>select ?is_rule_match where {
    bind({Has_Agitator} as ?has_agitator).
    bind({Has_Liquid_Input} as ?has_liquid_input).
    bind(
        if(
            ?has_agitator &amp;&amp;
            ?has_liquid_input, 
            true, 
            false) as ?is_rule_match
    ).
}</hasSPARQL>
    </owl:NamedIndividual>
    


    <!-- https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#Power_Transfer_Rule_by_Supplied_Power -->

    <owl:NamedIndividual rdf:about="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#Power_Transfer_Rule_by_Supplied_Power">
