    <owl:NamedIndividual rdf:about="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#Solid-Liquid_Mass_Transfer_Rule">
        <rdf:type rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#Rule"/>
        <hasDescriptor rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#Has_Liquid_Input"/>
        <hasDescriptor rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#Has_Solid_Input"/>
        <isAssociatedWith rdf:resource="https://raw.githubusercontent.com/sustainable-processes/ontology/refs/heads/main/OntoMo/OntoMo.owl#Solid-Liquid_Mass_Transfer"/>
        <hasSPARQL>select ?is_rule_match where {
    bind({Has_Solid_Input} as ?has_solid_input).
    bind({Has_Liquid_Input} as ?has_liquid_input).
    bind(
        if(
            ?has_solid_input &amp;&amp;
            ?has_liquid_input, 
            true, 
            false) as ?is_rule_match
    ).
}</hasSPARQL>
    </owl:NamedIndividual>
    


